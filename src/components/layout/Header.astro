---
// Header.astro
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact', isCta: true },
];
---

<header class="w-full py-8 md:py-12 px-6 md:px-12 relative z-50">
  <div class="max-w-[1700px] mx-auto flex items-center justify-between">
    <!-- LOGO -->
    <a href="/" class="flex items-center relative z-[60]" aria-label="SSD Home">
      <img src="/images/logo.svg" alt="SSD" class="h-10 md:h-[52px] w-auto" />
    </a>

    <!-- NAV DESKTOP -->
    <nav class="hidden md:flex items-center gap-12 font-sans font-bold text-[30px] leading-none text-brand">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={
            link.isCta
              ? 'bg-orange text-white px-9 py-3.5 rounded-full hover:opacity-90 transition-opacity text-[30px] leading-none ml-2'
              : 'hover:opacity-70 transition-opacity'
          }
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- BOTTONE HAMBURGER -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 relative z-[60] focus:outline-none"
      aria-label="Apri menu"
    >
      <span class="bar w-8 h-[2px] bg-white transition-all duration-300"></span>
      <span class="bar w-8 h-[2px] bg-white transition-all duration-300"></span>
      <span class="bar w-8 h-[2px] bg-white transition-all duration-300"></span>
    </button>

    <!-- MENU OVERLAY MOBILE -->
    <div
      id="mobile-menu"
      class="fixed inset-0 w-screen h-screen bg-black/95 backdrop-blur-md flex flex-col justify-center items-center gap-8 text-2xl font-bold transition-all duration-300 opacity-0 pointer-events-none md:hidden z-50 overflow-hidden"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={
            link.isCta
              ? 'mobile-link bg-orange text-white px-8 py-3 rounded-full hover:opacity-90 transition-opacity text-xl mt-4'
              : 'mobile-link text-white hover:opacity-70 transition-opacity'
          }
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  function initMenu() {
    let scrollPosition = 0;
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const bars = toggleBtn?.querySelectorAll('.bar');

    if (!toggleBtn || !mobileMenu) return;

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;

      if (isOpen) {
        // 1. Salva la posizione dello scroll e blocca il body fisicamente
        scrollPosition = window.pageYOffset;
        document.body.style.overflow = 'hidden';
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollPosition}px`;
        document.body.style.width = '100%';
        document.documentElement.style.overflow = 'hidden';

        // Mostra il menu
        mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu?.classList.add('opacity-100', 'pointer-events-auto');

        // Trasforma l'hamburger in X
        if (bars && bars.length === 3) {
          bars[0].classList.add('translate-y-[8px]', 'rotate-45');
          bars[1].classList.add('opacity-0');
          bars[2].classList.add('-translate-y-[8px]', '-rotate-45');
        }
      } else {
        // Nasconde il menu
        mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto');
        mobileMenu?.classList.add('opacity-0', 'pointer-events-none');

        // 2. Sblocca il body e ripristina la posizione di scroll
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('position');
        document.body.style.removeProperty('top');
        document.body.style.removeProperty('width');
        document.documentElement.style.removeProperty('overflow');
        window.scrollTo(0, scrollPosition);

        // Ripristina l'hamburger
        if (bars && bars.length === 3) {
          bars[0].classList.remove('translate-y-[8px]', 'rotate-45');
          bars[1].classList.remove('opacity-0');
          bars[2].classList.remove('-translate-y-[8px]', '-rotate-45');
        }
      }
    }

    toggleBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>