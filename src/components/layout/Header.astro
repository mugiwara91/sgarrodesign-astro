---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
];
---

<header class="w-full py-8 md:py-12 px-6 md:px-12">
  <div class="max-w-[1700px] mx-auto flex items-center justify-between">
    <a href="/" class="flex items-center" aria-label="SSD Home">
      <!-- Logo forzato a 52px di altezza su desktop -->
      <img src="/images/logo.svg" alt="SSD" class="h-10 md:h-[52px] w-auto" />
    </a>

    <!-- Navigazione forzata a 30px fissi con font-bold -->
    <nav class="hidden md:flex items-center gap-12 font-sans font-bold text-[30px] leading-none text-brand">
      {navItems.map((item) => (
        <a href={item.href} class="hover:opacity-70 transition-opacity">
          {item.label}
        </a>
      ))}
      <!-- Bottone Contact proporzionato ai 30px di font -->
      <a 
        href="/contact" 
        class="bg-orange text-white px-9 py-3.5 rounded-full hover:opacity-90 transition-opacity text-[30px] leading-none ml-2"
      >
        Contact
      </a>
    </nav>
  </div>
</header>