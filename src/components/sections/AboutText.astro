---
const aboutText = `Whether you’re just starting out or already have a logo and visual identity, I can help your brand stand out and grow through the power of design, strategy, and visual storytelling.`;
---

<section class="px-6 md:px-10 py-24 md:py-36">
  <div class="max-w-5xl mx-auto text-center flex flex-col items-center">
    <!-- Testo principale in H3 (più grande, bold e d'impatto) -->
    <p class="font-sans font-bold text-3xl md:text-4xl lg:text-h3 leading-snug md:leading-tight text-brand whitespace-pre-line">
      {aboutText}
    </p>

    <!-- Bottone con font mono, label 'more about me' e padding maggiorato -->
    <a
      href="/about"
      class="inline-block mt-12 bg-ink text-white font-mono text-base md:text-lg px-8 py-4 rounded-full hover:opacity-80 transition-opacity"
    >
      more about me
    </a>
  </div>
</section>