---
const features = [
  {
    title: 'Stop guessing, start attracting clients the right way',
    description: 'Starting from your brand’s characteristics, we can identify what you really need (and what you don’t),  and find the best way to reach your target audience.',
  },
  {
    title: 'Look professional, consistent, and memorable',
    description: 'Lets create your logo, your entire visual identity system, and all the brand applications you need to make your brand shine.',
  },
  {
    title: 'A site that actually converts visitors into leads',
    description: 'Being online is essential for any business, and it’s the best way to make your brand stand out.',
  },
];
---

<section class="px-6 md:px-12 py-16 md:py-28 max-w-[1700px] mx-auto">
  <div class="flex flex-col">
    {features.map((feature, index) => (
      <div class={`py-12 md:py-20 ${index !== 0 ? 'border-t border-ink/15' : ''}`}>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          
          <!-- Colonna Sinistra: Super Header Serif (Instrument, 100px) -->
          <div class="lg:col-span-7 xl:col-span-8">
            <h2 class="font-serif text-[48px] sm:text-[60px] lg:text-[85px] xl:text-[100px] text-brand leading-[0.95] tracking-tight whitespace-pre-line">
              {feature.title}
            </h2>
          </div>

          <!-- Colonna Destra: Body (25px su desktop, allineato a destra) -->
          <div class="lg:col-span-5 xl:col-span-4 text-left lg:text-right pt-2 lg:pt-4">
            <p class="font-sans text-[20px] lg:text-[25px] text-ink leading-snug max-w-lg lg:ml-auto">
              {feature.description}
            </p>
          </div>

        </div>
      </div>
    ))}
  </div>
</section>