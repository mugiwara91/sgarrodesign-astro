<section class="px-6 md:px-10 pt-4 pb-16">
  <div class="max-w-[1600px] mx-auto">

<!-- BLOCCO LOCAL TIME (Turin, Italy) -->
<div class="text-right font-mono text-[15px] md:text-[18px] leading-snug tracking-tight text-ink/80 mb-6">
  <p>Turin, Italy</p>
  <p id="local-time">-- ------ ----<br />--:--:--</p>
</div>

    <img
      src="/images/sgarro-wordmark.svg"
      alt="Sgarro"
      class="w-full h-auto select-none"
    />
  </div>
</section>

<script>
  function updateClock() {
    const el = document.getElementById('local-time');
    if (!el) return;

    const now = new Date();
    const dateStr = now.toLocaleDateString('en-GB', {
      day: '2-digit', month: 'long', year: 'numeric',
    });
    const timeStr = now.toLocaleTimeString('en-GB', {
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
    });

    el.innerHTML = `${dateStr}<br />${timeStr}`;
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>