---
const projects = [
  {
    client: 'OINK BIKE',
    title: 'The joy of riding your dream bike',
    image: '/images/carousel/oink-thumbnails.jpg',
    href: '/work/oink-bike',
  },
  {
    client: 'kangrats',
    title: 'Designing a new way to job finding',
    image: '/images/carousel/kangrats-thumbnails.jpg',
    href: '/work/kangrats',
  },
  {
    client: 'monde',
    title: 'Elite brand sport',
    image: '/images/carousel/monde-thumbnails.jpg',
    href: '/work/monde',
  },
  {
    client: 'see all',
    title: 'Want to see more projects?',
    image: '/images/carousel/oink-thumbnails.jpg',
    href: '/work',
  },
];
---

<div id="carousel-wrapper" class="relative w-full overflow-hidden bg-background">
  <section id="carousel-section" class="h-screen w-full flex flex-col justify-center overflow-hidden">
    
    <div id="carousel-track" class="flex gap-8 md:gap-12 w-max px-6 md:px-12">
      {projects.map((project) => (
        <a
          href={project.href}
          class="shrink-0 w-[85vw] sm:w-[50vw] md:w-[45vw] lg:w-[38vw] xl:w-[34vw] group block"
        >
          <!-- Contenitore Immagine (Mostra <img> se c'è project.image, altrimenti SVG) -->
          <div class="w-full aspect-4/3 rounded-3xl md:rounded-[2.5rem] overflow-hidden bg-[#e5e5e5] mb-5 flex items-center justify-center border border-black/5 relative">
            {project.image ? (
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <svg class="w-16 h-16 text-black/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
          </div>

          <!-- Info Progetto -->
          <div class="flex flex-col gap-2 pr-2">
            <span class="font-mono text-sm md:text-base uppercase tracking-wider text-ink/70">
              {project.client}
            </span>
            
            <h2 class="font-sans font-bold text-3xl md:text-4xl lg:text-h2 text-ink leading-tight group-hover:opacity-75 transition-opacity">
              {project.title}
            </h2>
          </div>
        </a>
      ))}
    </div>

  </section>
</div>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const wrapper = document.getElementById('carousel-wrapper');
  const section = document.getElementById('carousel-section');
  const track = document.getElementById('carousel-track');

  if (wrapper && section && track) {
    const getScrollAmount = () => track.scrollWidth - window.innerWidth;

    gsap.to(track, {
      x: () => -getScrollAmount(),
      ease: 'none',
      scrollTrigger: {
        trigger: wrapper,
        start: 'top top',
        end: () => `+=${getScrollAmount()}`,
        pin: section,
        scrub: 1,
        invalidateOnRefresh: true,
      },
    });
  }
</script>