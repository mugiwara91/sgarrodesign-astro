---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Contact | Sgarro Design">
  <Header />

  <main class="pt-28 md:pt-36">
    <!-- 1. SEZIONE FORM CONTATTI -->
    <section class="max-w-225 mx-auto px-6 pb-24 md:pb-32 text-center">
      
      <!-- Titolo & Intro -->
      <h1 class="reveal-type font-display text-display-g leading-[1.05] text-ink mb-20 md:mb-28">
        Time to start
      </h1>
      <p class="reveal-type font-sans text-body-lg mb-12 md:mb-16">
        If you’re looking to refresh your brand, build one from scratch, or just have a chat to figure out how to make it grow — get in touch and let’s see how we can create something great together.
      </p>

<!-- Form -->
      <form id="contact-form" class="flex flex-col gap-4 text-left relative">
        <!-- CHIAVE API WEB3FORMS (Sostituisci con la tua access_key) -->
        <input type="hidden" name="access_key" value="12b09681-45b3-4887-9af0-303c72de3cec" />
        
        <!-- Campo Honeypot Anti-Spam (Nascosto agli utenti umani) -->
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <!-- Riga 1: Nome, Cognome, Email -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <input
            type="text"
            name="first_name"
            placeholder="Name"
            required
            class="w-full bg-[#e2e2e2] text-ink placeholder:text-ink/50 px-5 py-4 rounded-xl text-lg focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          />
          <input
            type="text"
            name="last_name"
            placeholder="Surname"
            required
            class="w-full bg-[#e2e2e2] text-ink placeholder:text-ink/50 px-5 py-4 rounded-xl text-lg focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="w-full bg-[#e2e2e2] text-ink placeholder:text-ink/50 px-5 py-4 rounded-xl text-lg focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          />
        </div>

        <!-- Riga 2: Telefono, Nome azienda -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <input
            type="tel"
            name="phone"
            placeholder="Phone"
            class="w-full bg-[#e2e2e2] text-ink placeholder:text-ink/50 px-5 py-4 rounded-xl text-lg focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          />
          <input
            type="text"
            name="company"
            placeholder="Name of the company"
            class="w-full md:col-span-2 bg-[#e2e2e2] text-ink placeholder:text-ink/50 px-5 py-4 rounded-xl text-lg focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          />
        </div>

        <!-- Riga 3: Textarea / Messaggio -->
        <div>
          <textarea
            name="message"
            rows="5"
            placeholder="How can I help?"
            required
            class="w-full bg-[#e2e2e2] text-ink placeholder:text-ink/50 p-5 rounded-2xl text-lg resize-none focus:outline-none focus:ring-2 focus:ring-black/20 transition-all"
          ></textarea>
        </div>

        <!-- Checkbox Privacy Policy (GDPR Compliance) -->
        <div class="flex items-start gap-3 mt-2 px-1">
          <input
            type="checkbox"
            id="privacy"
            name="privacy"
            required
            class="mt-1 h-4 w-4 rounded border-gray-300 text-black focus:ring-black/20 accent-black cursor-pointer"
          />
          <label for="privacy" class="text-xs text-ink/70 leading-relaxed cursor-pointer select-none">
            I have read and agree to the <a href="/privacy-policy" class="underline hover:text-ink transition-colors">Privacy Policy</a>.
          </label>
        </div>

        <!-- Messaggio di stato dell'invio -->
        <div id="form-status" class="hidden text-center py-2 font-mono text-sm rounded-lg transition-all"></div>

        <!-- Submit Button -->
        <div class="flex justify-center mt-6">
          <button
            type="submit"
            id="submit-btn"
            class="bg-black text-white font-mono text-sm md:text-base uppercase tracking-widest px-12 py-4 rounded-full hover:bg-neutral-800 active:scale-95 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            submit
          </button>
        </div>
      </form>
    </section>

    <!-- 2. SEZIONE CONTATTI DIRETTI & WORDMARK (SFONDO NERO) -->
    <section class="bg-black text-white pt-20 pb-12 px-6 overflow-hidden">
      <div class="max-w-350 mx-auto">
        
        <!-- Pill dei contatti -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
          
          <div class="flex flex-col items-center gap-3">
            <span class="font-mono text-xs md:text-sm uppercase tracking-widest text-orange">EMAIL</span>
            <a
              href="mailto:sgarrodesign@gmail.com"
              class="w-full text-center border border-white/30 rounded-full py-4 px-6 font-mono text-base md:text-lg hover:border-white hover:bg-white hover:text-black transition-all"
            >
              sgarrodesign@gmail.com
            </a>
          </div>

          <div class="flex flex-col items-center gap-3">
            <span class="font-mono text-xs md:text-sm uppercase tracking-widest text-orange">TELEPHONE</span>
            <a
              href="tel:+393931784472"
              class="w-full text-center border border-white/30 rounded-full py-4 px-6 font-mono text-base md:text-lg hover:border-white hover:bg-white hover:text-black transition-all"
            >
              (+39) 3931784472
            </a>
          </div>

          <div class="flex flex-col items-center gap-3">
            <span class="font-mono text-xs md:text-sm uppercase tracking-widest text-orange">INSTAGRAM</span>
            <a
              href="https://www.instagram.com/sgarro.design/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center border border-white/30 rounded-full py-4 px-6 font-mono text-base md:text-lg hover:border-white hover:bg-white hover:text-black transition-all"
            >
              @sgarrodesign
            </a>
          </div>

        </div>

        <!-- Mega Wordmark SGARRO -->
        <div class="w-full flex justify-center items-center">
          <img
            src="/images/sgarro-wordmark.svg"
            alt="Sgarro"
            class="w-full h-auto select-none"
          />
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const statusDiv = document.getElementById('form-status');

    if (!form || !submitBtn || !statusDiv) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disabilita il pulsante durante l'invio
      submitBtn.disabled = true;
      const originalBtnText = submitBtn.innerText;
      submitBtn.innerText = 'SENDING...';

      statusDiv.classList.add('hidden');
      statusDiv.className = 'text-center py-3 px-4 font-mono text-sm rounded-lg transition-all';

      const formData = new FormData(form);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          statusDiv.innerText = 'Message sent successfully! I will get back to you soon.';
          statusDiv.classList.remove('hidden');
          statusDiv.classList.add('bg-green-100', 'text-green-800');
          form.reset();
        } else {
          throw new Error(result.message || 'Something went wrong');
        }
      } catch (error) {
        statusDiv.innerText = 'Oops! Something went wrong. Please try emailing directly.';
        statusDiv.classList.remove('hidden');
        statusDiv.classList.add('bg-red-100', 'text-red-800');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>