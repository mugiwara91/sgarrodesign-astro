---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto SSC Bari
const project = {
  title: 'SSC Bari',
  meta: [
    'Brand Strategy',
    'Naming',
    'Logo Design',
    'Brand System',
    'Web Design',
    'Sviluppo WordPress',
  ],
  intro: `L'SSC Bari è una squadra di calcio italiana che milita attualmente in Serie B, ma con una storia legata alla Serie A. Fondata nel 1905, rappresenta uno dei simboli del calcio italiano e, soprattutto, una delle principali realtà del Sud Italia, una zona che spesso fatica a emergere in un settore dominato dai tre giganti del Nord: Juventus, Milan e Inter.`,
  secondText: `L'Obiettivo\nIl rebranding, mai proposto ufficialmente al club, nasce con l'intento di modernizzare l'identità visiva della squadra biancorossa — conosciuta anche come "i Galletti" — preservandone al tempo stesso il simbolo storico.\nIl nuovo logo è stato progettato per risultare più funzionale nei diversi formati e contesti d'uso, mantenendo una forte riconoscibilità.\nLa palette cromatica è stata aggiornata: il rosso tradizionale è stato leggermente schiarito per ottenere una tonalità più vibrante, abbinata a bianco, nero e oro, con l'obiettivo di dare all'identità visiva un tono più moderno ed elegante.\n\nIl Sistema di Brand\nIl carattere tipografico selezionato per il brand è Bebas, scelto per il suo equilibrio tra modernità e leggibilità.\nLa sua struttura solida e versatile contribuisce a comunicare un'identità forte, coerente e facilmente riconoscibile.`,
};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden flex items-center justify-center">
          <img
            src="/images/work/bari/bari-logo.png"
            alt={project.title}
            class="w-full h-full object-cover"
          />
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-display text-display-g text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Attività</span>
            {project.meta.map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">
        
        <!-- Media 1: Historical Logos Comparison -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/bari/bari-logo-history.png"
            alt="Historical Logos"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 2: Stadium Aerial Graphic -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/bari/bari-field.png"
            alt="Stadium Graphic"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 3: Crest on Flag Mockup -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-200 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/bari/bari-flag.png"
            alt="Crest Flag Mockup"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Blocco Testo Intermedio -->
        <div class="w-full py-12 md:py-16">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <div class="reveal-me opacity-0 md:col-start-5 md:col-span-8 lg:col-start-4 lg:col-span-9 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
              {project.secondText}
            </div>
          </div>
        </div>

        <!-- Media 4: Color Palette Display (Rosso, Oro, Bianco) -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-950 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/bari/bari-colors.png"
            alt="Color Palette"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 5: Griglia 2 colonne - Kit Mockups in-use -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/bari/bari-shirt-1.png"
              alt="Home Kit"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/bari/bari-shirt-.png"
              alt="Away Kit"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-white/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/next-project"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>