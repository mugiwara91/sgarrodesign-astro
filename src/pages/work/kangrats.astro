---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto (struttura riutilizzabile per tutti gli altri lavori)
const project = {
  title: 'Kangrats',
  meta: [
    'Brand Strategy',
    'Naming',
    'Logo Design',
    'Brand System',
    'Web Design',
    'WordPress Developement',
    'Illustration',
    'App Design',
  ],
intro: `Kangrats was born in 2022 with the goal of revolutionizing the job search experience.The project began that summer with the aim of developing a new visual identity — from naming to the desktop app interface.For several months, the focus was entirely on brand strategy: analyzing the job market, defining user personas, studying their preferences, and exploring positioning opportunities in a highly competitive field.`,
secondText: `The naming process started from the idea of celebrating the joy of finding a new job.Inspired by the word “Congrats”, the team wanted something evocative and memorable, rather than purely descriptive.That’s how Kangrats was born — a playful fusion of “kangaroo” and “congrats”.The kangaroo symbolizes agility and forward motion, perfectly reflecting the app’s mission: making job searching faster, smoother, and more accessible.
The logo features a happy kangaroo inside a speech bubble, representing the connection between candidates and employers through direct and effortless communication.
Typography and colors were chosen to convey a fresh, youthful feel, targeting an audience under 30.The main color, orange, stands out from the usual blues and purples used by competitors, creating a vibrant and recognizable visual identity built on bold contrasts and dynamic energy.`,
};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-800 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/kangrats-billboard.webp"
            alt={project.title}
            class="w-full h-full object-cover"
          />
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-display text-display-g text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Attività</span>
            {project.meta.map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY (GRIGLIA MODULARE) -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">
        
       
       
        <!-- INSERIRE VIDEO!!! -->


        <!-- Media 2: Griglia a 2 colonne (50/50) -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/kangrats-mobile-app.webp"
              alt="Asset 1"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/kangrats-thumbnail.jpg"
              alt="app icon
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 3: Altra griglia a 2 colonne (Illustrazioni/Mascotte) -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/kangrats-illustration-1.jpg"
              alt="Illustration 1"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
              src="/images/work/kangrats/kangrats-illustration-2.jpg"
              alt="Illustration 2"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Blocco Testo Intermedio -->
        <div class="w-full py-12 md:py-16">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <div class="reveal-me opacity-0 md:col-start-5 md:col-span-8 lg:col-start-4 lg:col-span-9 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
              {project.secondText}
            </div>
          </div>
        </div>

        <!-- Media 4: Desktop Interface Showcase -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/kangrats-web_design.webp"
            alt="Desktop Showcase"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 5: UI Feature Banner -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-brand/20 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/kangrats-itsamatch.webp"
            alt="UI Feature"
            class="w-full h-full object-cover"
          />
        </div>

        
        <!-- Media 5: UI Feature Banner -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-brand/20 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/kangrats-desktop-app.webp"
            alt="UI Feature"
            class="w-full h-full object-cover"
          />
        </div>



        <!-- Media 7: Triple Mobile Showcase -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-200 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/kangrats/kangrats-3mobile.webp"
            alt="Mobile Screens"
            class="w-full h-full object-cover"
          />
        </div>

      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION (GO BACK / GO NEXT) -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-ink/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-ink/30 hover:border-ink hover:bg-ink hover:text-bg transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/yarnlog"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-ink/30 hover:border-ink hover:bg-ink hover:text-bg transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>