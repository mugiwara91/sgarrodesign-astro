---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto (struttura riutilizzabile per tutti gli altri lavori)
const project = {
  title: 'Kangrats',
  meta: [
    'Brand Strategy',
    'Naming',
    'Logo Design',
    'Brand System',
    'Web Design',
    'Sviluppo WordPress',
  ],
  intro: `Kangrats è nata nel 2022 con l'obiettivo di rivoluzionare il mondo della ricerca di lavoro.\nIl progetto ha preso avvio nell'estate del 2022, con l'obiettivo di sviluppare una nuova identità visiva per il brand, partendo dal naming e arrivando fino all'interfaccia dell'applicazione desktop. Per diversi mesi, il lavoro si è concentrato esclusivamente sulla brand strategy: analisi del contesto attuale del job market, definizione delle user personas, studio delle loro preferenze e valutazione delle strategie di posizionamento e comunicazione in un mercato altamente competitivo.`,
  secondText: `La ricerca del nome è partita dal desiderio di evocare la soddisfazione legata al trovare un nuovo lavoro.\nL'idea centrale ruotava attorno al concetto di congratulazioni, un momento che celebra il raggiungimento di un obiettivo personale o professionale. Si è scelto di evitare un nome troppo descrittivo rispetto alla funzione dell'app, puntando invece su qualcosa di evocativo e memorabile. Da qui nasce il gioco con la parola "Congrats", combinata a un elemento simbolico: una mascotte.\nÈ così che prende forma Kangrats.\nIl canguro è stato scelto per le sue caratteristiche: è un animale agile, dinamico, capace di compiere balzi rapidi da un punto all'altro.\nUn'associazione perfetta con l'obiettivo dell'app: rendere il processo di ricerca del lavoro più veloce, fluido e accessibile.`,
};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-800 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/Kangrats-cover.png"
            alt={project.title}
            class="w-full h-full object-cover"
          />
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-display text-display-g text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Attività</span>
            {project.meta.map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY (GRIGLIA MODULARE) -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">
        
        <!-- Media 1: Hero Visual Full Width -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-200 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/kangrats/Kangrats-logo.png"
            alt="Brandmark"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 2: Griglia a 2 colonne (50/50) -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/Kangrats-motion.png"
              alt="Asset 1"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/Kangrats-bottle.png"
              alt="Asset 2"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 3: Altra griglia a 2 colonne (Illustrazioni/Mascotte) -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/kangrats/Kangrats-illustration-1.png"
              alt="Illustration 1"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
              src="/images/work/kangrats/Kangrats-illustration-2.png"
              alt="Illustration 2"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Blocco Testo Intermedio -->
        <div class="w-full py-12 md:py-16">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <div class="reveal-me opacity-0 md:col-start-5 md:col-span-8 lg:col-start-4 lg:col-span-9 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
              {project.secondText}
            </div>
          </div>
        </div>

        <!-- Media 4: Desktop Interface Showcase -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/Kangrats-web.png"
            alt="Desktop Showcase"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 5: UI Feature Banner -->
<!--         <div class="reveal-me opacity-0 w-full aspect-video bg-brand/20 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/kangrats/Kangrats-illustration-2.png"
            alt="UI Feature"
            class="w-full h-full object-cover"
          />
        </div> -->

        <!-- Media 6: UI Details Grid (Icone + Mobile Hand) -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/kangrats/Kangrats-icons.png"
              alt="Icon System"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-100 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/kangrats/Kangrats-screen-app.png"
              alt="Mobile Mockup"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 7: Triple Mobile Showcase -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-200 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/kangrats/Kangrats-app.png"
            alt="Mobile Screens"
            class="w-full h-full object-cover"
          />
        </div>

      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION (GO BACK / GO NEXT) -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-ink/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-ink/30 hover:border-ink hover:bg-ink hover:text-bg transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/next-project"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-ink/30 hover:border-ink hover:bg-ink hover:text-bg transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>