---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto Oink Bike
const project = {
  title: 'Oink Bike',
  meta: [
    'Brand Strategy',
    'Illustration',
    'Logo Design',
    'Brand System',,
  ],
  intro: `Oink is a bike lab located in the Santa Rita district of Turin.The collaboration began with the idea of creating something more than just a shop where locals bring their bikes for repairs. The goal was to build a community and an environment where a certain type of cyclist could identify with — and even laugh at — their own quirks.
The name “Oink” was chosen by the client as a playful reference to the muddy trails where MTB (mountain bike) enthusiasts ride, linking it to the sound made by pigs.`,
  secondText: `he illustration features a pig wearing a cycling cap, a direct nod to the brand’s target audience. The goal was to turn this character into a recognizable brand icon, adaptable across various products — from caps and T-shirts to bottles, stickers, and other merchandise that cyclists in Turin and beyond can wear with pride.
To ensure visual consistency, we developed a color system inspired by the MTB world — yet intentionally breaking away from it.While the cycling scene is often clean and refined, Oink embraces a deliberately rougher aesthetic.The color palette not only recalls the pig’s pink, but also includes complementary hues and contrasting tones inspired by 1970s Italian workshops, resulting in a distinctive and instantly recognizable identity.`};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden flex items-center justify-center">
          <img
            src="/images//work/oink/oink-stickers.png"
            alt={project.title}
            class="w-full h-full object-cover"
          />
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-display text-display-g text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Attività</span>
            {project.meta.map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">
        
        <!-- Media 1: Griglia 2 colonne - Splash Mud Bike + Pig Mascot Sticker -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-fango.jpg"
              alt="MTB Mud Splash Action"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-logo-color.webp"
              alt="Oink Pig Mascot"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 2: Script Wordmark Logotype -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-950 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/oink/oink-logo.png"
            alt="Oink Script Logotype"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 3: Griglia 2 colonne - Frame Decal + Yellow Pole Sticker -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-telaio.webp"
              alt="Oink Frame Decal"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-sticker.webp"
              alt="Oink Sticker Outdoor"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 4: Griglia 2 colonne - Water Bottle Mockup + T-Shirt Back Print -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-[#fbaed2]/20 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-bottle.webp"
              alt="Oink Water Bottle"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/oink/oink-shirt.webp"
              alt="Oink T-Shirt Back Print"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Blocco Testo Intermedio -->
        <div class="w-full py-12 md:py-16">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <div class="reveal-me opacity-0 md:col-start-5 md:col-span-8 lg:col-start-4 lg:col-span-9 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
              {project.secondText}
            </div>
          </div>
        </div>

        <!-- Media 5: Cycling Cap Product Mockup -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-950 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/oink/oink-cap.jpg"
            alt="Oink Cycling Cap"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 6: Ciclofficina Exterior Signage -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/oink/oink-insegna.jpg"
            alt="Ciclofficina Oink Signage"
            class="w-full h-full object-cover"
          />
        </div>

      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-white/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/next-project"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>