---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto Sogar Music
const project = {
  title: 'Sogar Music',
  meta: [
    'Brand Strategy',
    'Naming',
    'Logo Design',
    'Brand System',
    'Web Design',
    'Sviluppo Wordpress',
  ],
  intro: `L'illustrazione di questa cover rappresenta le case popolari di Via Roveda, un quartiere importante per la città di Torino e per quello che ha rappresentato negli anni della Fiat e del boom economico della città.\n\nMa molto importante lo è anche per Sogar (anagramma del mio nome per quando mi travesto da musicista). Quelle case sono il luogo in cui da bambino ho scoperto la musica, pur senza prendere in mano uno strumento o quasi e in cui conservo tanti ricordi felici passati a casa dei nonni.\n\nSogar è un musicista multi-strumentista che mischia chitarra, basso, tastiere e fiati per creare dei beat. Su youtube è presente qualche suo brano e presto ne arriveranno altri.`,
};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden flex items-center justify-center">
          <img
            src="/images//work/sogar/sogar-illustration.png"
            alt={project.title}
            class="w-full h-full object-cover"
          />
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-serif text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Attività</span>
            {project.meta.map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">
        
        <!-- Media 1: Griglia 2 colonne - Cover Art Artwork + Purple Vinyl Disc -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/sogar/sogar-cover.png"
              alt="Simon Sogar - Childhood Album Artwork"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-950 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images//work/sogar/sogar-inside.png"
              alt="Sogar Childhood Purple Vinyl"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 2: Via Roveda Buildings Illustration Wide -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/sogar/sogar-mockup.png"
            alt="Via Roveda Turin Buildings Illustration"
            class="w-full h-full object-cover"
          />
        </div>



      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-white/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/next-project"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>