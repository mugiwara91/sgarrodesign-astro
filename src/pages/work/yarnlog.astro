---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/layout/Footer.astro';

// Dati del progetto YarnLog
const project = {
  title: 'YarnLog',
  meta: [
    'Services',
    'Naming',
    'Logo Design',
    'Brand System',
    'Web Design',
    'Wordpress Developement',
  ],
  intro: `Yarn-Log is a software engineering company active since 2022.Although it’s a small business, it collaborates with notable clients and develops advanced projects, including solutions based on artificial intelligence.
Our collaboration began in the summer of 2022, without an established visual direction but with clear goals from the company.We started by working on the brand strategy: defining the target audience, positioning, brand analysis, and competitor research.`,
  secondTextLabel: 'Shapes',
  secondText: `The brand strategy process also led us to the creation of the name.From the analysis, the company’s role became clear: to turn complex, structured projects into concrete, intuitive solutions and, when needed, beautifully crafted ones.
A bit like a thread of yarn that, through weaving, takes shape and becomes something functional.That’s where the idea of Yarn came from.`,
};
---

<Layout title={`${project.title} | Case Study`}>
  <div class="bg-black text-white min-h-screen w-full">
    <Header />

    <main class="w-full">
      <!-- 1. HERO COVER IMAGE -->
      <section class="w-full px-6 md:px-12 pt-8 pb-16">
        <div class="reveal-me opacity-0 w-full aspect-video bg-[#4f46e5] rounded-2xl md:rounded-3xl overflow-hidden flex items-center justify-center">
          <video
            src="/videos/yarnlog-motion-1.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover"
          ></video>
        </div>
      </section>

      <!-- 2. PROJECT HEADER INFO -->
      <section class="w-full px-6 md:px-12 pb-20 md:pb-28">
        <h1 class="reveal-me opacity-0 font-display text-display-g text-5xl md:text-7xl lg:text-8xl text-white tracking-tight mb-12 md:mb-16">
          {project.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Colonna Sinistra: Metadati / Attività -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-widest text-orange mb-2">Services</span>
            {project.meta.slice(1).map((item) => (
              <span class="font-mono text-xs md:text-sm text-white/80">{item}</span>
            ))}
          </div>

          <!-- Colonna Destra: Intro Text -->
          <div class="reveal-me opacity-0 md:col-span-6 lg:col-span-6 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
            {project.intro}
          </div>
        </div>
      </section>

      <!-- 3. CASE STUDY MEDIA GALLERY -->
      <section class="w-full px-6 md:px-12 pb-24 space-y-8 md:space-y-12">


       <!-- Media 3: Laptop Workplace Mockup -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images/work/yarnlog/yarnlog-web design.jpg"
            alt="YarnLog Workplace"
            class="w-full h-full object-cover"
          />
        </div>
        

        <!-- Blocco Testo Intermedio con Label "La forma" -->
        <div class="w-full py-12 md:py-16">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <div class="reveal-me opacity-0 md:col-span-4 lg:col-span-3">
              <span class="font-mono text-xs uppercase tracking-widest text-white/60">
                {project.secondTextLabel}
              </span>
            </div>
            <div class="reveal-me opacity-0 md:col-span-8 lg:col-span-9 font-sans text-body-lg text-white/90 leading-relaxed whitespace-pre-line">
              {project.secondText}
            </div>
          </div>
        </div>



        <!-- Media 4: Griglia 2 colonne - Typography (Darker Grotesque) + Color Palette Block -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/yarnlog/yarnlog-thypography.jpg"
              alt="Darker Grotesque Typography"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/yarnlog/yarnlog-colors.jpg"
              alt="YarnLog Color System"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Media 5: Wall 3D Signage Mockup -->
        <div class="reveal-me opacity-0 w-full aspect-video bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
          <img
            src="/images//work/yarnlog/yarnlog-wall.jpg"
            alt="3D Wall Signage"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Media 4: Griglia 2 colonne - Typography (Darker Grotesque) + Color Palette Block -->
        <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/yarnlog/yarnlog-felpa.jpg"
              alt="Apparel"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="reveal-me opacity-0 w-full aspect-square bg-neutral-900 rounded-2xl md:rounded-3xl overflow-hidden">
            <img
            src="/images/work/yarnlog/yarnlog-logo.png"
              alt="YarnLog Logo on black"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </section>

      <!-- 4. BOTTOM PROJECT NAVIGATION -->
      <section class="reveal-me opacity-0 w-full px-6 md:px-12 py-12 border-t border-white/10">
        <div class="flex justify-between items-center font-mono text-xs md:text-sm uppercase tracking-widest">
          <a
            href="/work"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            <span>&lt;</span> GO BACK
          </a>

          <a
            href="/work/next-project"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 hover:border-white hover:bg-white hover:text-black transition-all"
          >
            GO NEXT <span>&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <FinalCta />
  <Footer />
</Layout>

<!-- SCRIPT GSAP & SCROLLTRIGGER -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animazione per elementi singoli
  const singleElements = document.querySelectorAll('.reveal-me:not(.reveal-grid .reveal-me)');
  
  singleElements.forEach((el) => {
    gsap.fromTo(
      el,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Animazione a cascata (stagger) per le griglie a 2 colonne
  const grids = document.querySelectorAll('.reveal-grid');
  
  grids.forEach((grid) => {
    const items = grid.querySelectorAll('.reveal-me');
    gsap.fromTo(
      items,
      {
        y: 45,
        opacity: 0,
      },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>